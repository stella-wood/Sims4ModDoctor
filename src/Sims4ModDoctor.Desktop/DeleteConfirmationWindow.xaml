<Window x:Class="Sims4ModDoctor.Desktop.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="320"
        Height="142"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="确定删除所选文件？"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="14"
                   FontWeight="Normal"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="40"
                    Height="28"
                    Margin="0,0,8,0"
                    Content="否"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="0"
                    FontSize="12"
                    FontWeight="Normal"
                    Click="Cancel_Click" />
            <Button Width="40"
                    Height="28"
                    Content="是"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="0"
                    FontSize="12"
                    FontWeight="Normal"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
